# Production .env template. Copy to .env.prod and fill in real values before
# `docker compose -f docker-compose.prod.yml up`.
#
# Anything tagged <PLACEHOLDER> must be replaced. Leave nothing committed
# to git in .env.prod.

# === Core ===
APP_ENV=production
APP_VERSION=1.0.0
# REQUIRED. Signs JWTs (HS256) + derives the AES key for stored OpenRouter
# api_keys. The server HARD-FAILS at startup (RuntimeError) when APP_ENV is not
# 'development' and this is empty, <32 chars, or an obvious placeholder.
# Generate: `openssl rand -hex 32`.
# NOTE: if the app was ever started with an empty/placeholder key, rotate this
# value AND re-encrypt every api_keys row under the new key before relying on it.
SECRET_KEY=<64-char-random-hex>
CORS_ORIGINS=https://your-domain.com
# Base URL of the public frontend — used in password-reset email links
# (auth_service.py). Defaults to localhost in code, so it MUST be set here or
# reset emails point at localhost.
FRONTEND_URL=https://your-domain.com

# Domain used by scripts/init_letsencrypt.sh and referenced from nginx config.
DOMAIN=your-domain.com

# === Database (managed PostgreSQL, NOT a Compose service) ===
DATABASE_URL=postgresql+asyncpg://<user>:<pass>@<managed-pg-host>:5432/trinity
# Per-worker SQLAlchemy pool. 4 gunicorn workers × (25+15) = 160 client connections
# to PgBouncer, + up to 3 cron procs × 40 = ≤280 (≤ max_client_conn=500). PgBouncer
# multiplexes onto default_pool_size(100)+reserve_pool_size(20)=120 real Postgres
# conns, under max_connections=200. (tr-3hs §H1, raised in tr-4fy.3)
DATABASE_POOL_SIZE=25
DATABASE_MAX_OVERFLOW=15
# Seconds to wait for a free pooled connection before a fast 503 (tr-3hs).
DATABASE_POOL_TIMEOUT=10

# === Concurrency / backpressure (tr-3hs §H1/H2) ===
# Per-worker uvicorn global request cap (4 workers → 800 HTTP ceiling).
WORKER_LIMIT_CONCURRENCY=200
# Per-worker preemptive limits → instant 503+Retry-After when full, instead of
# queueing on DATABASE_POOL_TIMEOUT. Auth caps concurrent bcrypt threads;
# conversation sits just above the pool so only genuine overload sheds.
AUTH_BACKPRESSURE_LIMIT=40
CONVERSATION_BACKPRESSURE_LIMIT=50

# === Redis (Compose-internal hostname) ===
REDIS_URL=redis://redis:6379/0

# === Auth ===
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=15
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7
JWT_REFRESH_TOKEN_ABSOLUTE_EXPIRE_DAYS=14
BCRYPT_ROUNDS=12

# === Yandex OAuth ===
YANDEX_CLIENT_ID=<yandex-app-id>
YANDEX_CLIENT_SECRET=<yandex-app-secret>
YANDEX_REDIRECT_URI=https://your-domain.com/api/v1/auth/yandex/callback

# === OpenRouter ===
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_DEFAULT_API_KEY=<initial-key>
# Additional keys managed via the admin panel, not env vars.

# === YooKassa ===
YOOKASSA_SHOP_ID=<shop-id>
YOOKASSA_SECRET_KEY=<secret-key>
YOOKASSA_RETURN_URL=https://your-domain.com/balance

# === Email (Resend HTTP API) ===
RESEND_API_KEY=<resend-api-key>
RESEND_FROM_EMAIL=Trinity <noreply@your-domain.com>
ADMIN_EMAIL=admin@your-domain.com

# === Telegram (admin alerts) ===
TELEGRAM_BOT_TOKEN=<bot-token>
TELEGRAM_CHAT_ID=<chat-id>

# === Backups (S3-compatible — Yandex Object Storage in production) ===
S3_ENDPOINT=https://storage.yandexcloud.net
S3_ACCESS_KEY=<your-static-key-id>
S3_SECRET_KEY=<your-static-key-secret>
S3_BUCKET=trinity-backups

# === Monitoring ===
HEALTH_CHECK_INTERVAL_SECONDS=300
OPENROUTER_BALANCE_THRESHOLD_USD=5

# === Demo flags — production MUST keep these false ===
DEMO_MODE=false
EMAIL_DEMO_MODE=false
# TELEGRAM_DEMO_MODE defaults True in code (alerts suppressed); prod MUST set it
# false or all admin/reconciliation Telegram alerting is silently off.
TELEGRAM_DEMO_MODE=false

# === Login brute-force throttling (tr-dfem) ===
# Defaults are sane; uncomment to override. List values are JSON.
# LOGIN_FAIL_WINDOW_SECONDS=900
# LOGIN_FAIL_THRESHOLD=5
# LOGIN_FAIL_THRESHOLD_ADMIN=3
# LOGIN_BLOCK_STEPS_SECONDS=[60,300,900,3600]
# LOGIN_BLOCK_STEPS_ADMIN_SECONDS=[300,1800,3600,3600]
# Email for security alerts (admin login failures, account blocks). Empty = log only.
SECURITY_ALERT_EMAIL=
