# === Core ===
APP_ENV=production                    # development | production
APP_VERSION=1.0.0
SECRET_KEY=<64-char-random-hex>       # JWT signing, CSRF tokens
CORS_ORIGINS=https://trinity.example.com

# === Database ===
DATABASE_URL=postgresql+asyncpg://user:pass@managed-pg-host:5432/trinity
# Per-worker SQLAlchemy pool (tr-4fy.3): 25+15. See config.py budget invariants.
DATABASE_POOL_SIZE=25
DATABASE_MAX_OVERFLOW=15

# === Redis ===
REDIS_URL=redis://redis:6379/0

# === Auth ===
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=15
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7
JWT_REFRESH_TOKEN_ABSOLUTE_EXPIRE_DAYS=14
BCRYPT_ROUNDS=12

# === Yandex OAuth ===
YANDEX_CLIENT_ID=<yandex-app-id>
YANDEX_CLIENT_SECRET=<yandex-app-secret>
YANDEX_REDIRECT_URI=https://trinity.example.com/api/v1/auth/yandex/callback

# === OpenRouter ===
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_DEFAULT_API_KEY=<initial-key>
# Additional keys managed via DB, not env vars

# === YooKassa ===
YOOKASSA_SHOP_ID=<shop-id>
YOOKASSA_SECRET_KEY=<secret-key>
YOOKASSA_RETURN_URL=https://trinity.example.com/balance

# === Email (Resend HTTP API) ===
RESEND_API_KEY=re_mock_key_for_demo
RESEND_FROM_EMAIL=Trinity <noreply@trinity.example.com>
# Recipient for critical alert emails. Leave empty to suppress alert mail.
ADMIN_EMAIL=admin@example.com

# === Email (Yandex SMTP — legacy, retained for backward compat) ===
SMTP_HOST=smtp.yandex.ru
SMTP_PORT=465
SMTP_USER=noreply@trinity.example.com
SMTP_PASSWORD=<smtp-password>
SMTP_FROM=noreply@trinity.example.com

# === Telegram (Admin Alerts) ===
TELEGRAM_BOT_TOKEN=mock_token
TELEGRAM_CHAT_ID=000000000

# === Backups (S3-compatible storage; Yandex Object Storage in production) ===
S3_ENDPOINT=https://storage.yandexcloud.net
S3_ACCESS_KEY=<your-static-key-id>
S3_SECRET_KEY=<your-static-key-secret>
S3_BUCKET=trinity-backups

# === Monitoring ===
HEALTH_CHECK_INTERVAL_SECONDS=300
OPENROUTER_BALANCE_THRESHOLD_USD=5.0

# === Demo ===
# DEMO_MODE=true skips real OpenRouter calls in the billing pipeline.
# The billing engine (reservation, finalization, debit, history) still runs.
DEMO_MODE=false
# Independent override so emails can go live (false) while the rest of the
# platform stays in demo (true). Defaults to true.
EMAIL_DEMO_MODE=true
# Independent override so chat routes through the REAL OpenRouter proxy while
# the rest of the platform stays in demo. Requires a primary, active key in the
# api_keys table (added via /admin/keys) — the proxy reads it from the DB, not
# from env. Defaults to true (demo proxy).
OPENROUTER_DEMO_MODE=true
# Independent override so admin alerts reach Telegram while the rest of the
# platform stays in demo. Requires TELEGRAM_BOT_TOKEN and TELEGRAM_CHAT_ID.
# Defaults to true (Telegram suppressed).
TELEGRAM_DEMO_MODE=true
